# Supabase (D6). 브라우저에서도 읽으므로 NEXT_PUBLIC_ 접두사. Vercel 에는 이 두 키만 등록한다.
#   로컬: supabase start 후 `supabase status` 의 API URL / anon key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. .env.local 과 시드/관리 스크립트에만 두고 Vercel 에는 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# (선택) Cloudflare Turnstile CAPTCHA. 사이트 키가 있을 때만 로그인·가입·재설정 화면에 위젯을 그리고 captchaToken 을 보낸다.
#   비워 두면 지금과 똑같이 동작한다. Vercel(production)에 넣고 배포한 뒤에 호스팅 CAPTCHA 를 켠다 — README "CAPTCHA 켜기"
#   로컬 테스트 키(항상 통과): 1x00000000000000000000AA / (항상 실패): 2x00000000000000000000AB
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 서버 전용(.env.local). scripts/apply-hosted-auth.sh 가 읽어 호스팅 CAPTCHA 를 켠다. Vercel 에는 넣지 않는다.
TURNSTILE_SECRET_KEY=

# (선택) 방 만들기 AI 인터뷰(스펙 2026-10-23 D19). 서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 않는다.
#   Vercel(production)에 ANTHROPIC_API_KEY 를 넣으면 /rooms/new 에 「직접 입력 | AI 인터뷰」 세그먼트가 생긴다. 비우면 지금 화면 그대로.
#   월 예산 알림은 Anthropic 콘솔에서 따로 건다. 사용 상한은 DB ai_limits()(0047).
ANTHROPIC_API_KEY=
# 기본 claude-haiku-5-5. 문구 품질이 아쉬우면 claude-sonnet-5-5(비용 약 20배 — ai_limits().globalPerDay 도 함께 낮춘다)
AI_INTERVIEW_MODEL=claude-haiku-5-5
# 로컬·E2E 전용: 1 이면 키 없이 대본으로 응답한다. Vercel 에는 넣지 않는다.
AI_INTERVIEW_MOCK=
